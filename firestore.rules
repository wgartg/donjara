rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 部屋 1つ = ドキュメント 1つ(ID は英大文字4文字の部屋コード)
    match /rooms/{code} {
      function signedIn() {
        return request.auth != null;
      }
      function shapeOk() {
        return request.resource.data.keys().hasOnly(['fmt', 'code', 'status', 'hostId', 'memberIds', 'updatedAt', 'expireAt', 'json'])
          && request.resource.data.code == code
          && request.resource.data.json is string
          && request.resource.data.json.size() < 200000
          && request.resource.data.memberIds is list
          && request.resource.data.memberIds.size() <= 4;
      }

      // 匿名ログインした人なら部屋の一覧と中身を読める
      allow read: if signedIn();

      // 部屋を作れるのは、自分がホストとして入っている部屋だけ
      allow create: if signedIn()
        && code.matches('^[A-Z]{4}$')
        && shapeOk()
        && request.resource.data.hostId == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds;

      // 書き換えられるのは参加者だけ(参加するとき・抜けるときも含む)
      allow update: if signedIn()
        && shapeOk()
        && (request.auth.uid in resource.data.memberIds
            || request.auth.uid in request.resource.data.memberIds);

      // 部屋を消せるのはホストだけ
      allow delete: if signedIn() && resource.data.hostId == request.auth.uid;
    }

    // それ以外は全部しめる
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
